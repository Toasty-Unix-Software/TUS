# Makefile fragment for kernel/arch/.
# kernel/arch/ only holds one target (x86_64) today - this just forwards
# to it, the same "one Makefile per folder" pattern the rest of the tree
# uses, so a second architecture would slot in the same way.

include kernel/arch/x86_64/Makefile

SRCS_ARCH := $(SRCS_ARCH_X86_64)
